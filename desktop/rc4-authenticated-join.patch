--- /dev/null
+++ b/server/host_join.py
@@ -0,0 +1,48 @@
+"""Identify the Expanse service at the address the player chose to join."""
+import json
+from urllib.error import HTTPError
+from urllib.parse import urlsplit
+from urllib.request import HTTPRedirectHandler, build_opener
+
+
+def origin(url):
+    parsed = urlsplit(url)
+    if parsed.scheme not in ('http', 'https') or not parsed.hostname or parsed.username is not None or parsed.password is not None:
+        return None
+    return parsed.scheme, parsed.hostname.lower(), parsed.port or (443 if parsed.scheme == 'https' else 80)
+
+
+class SameOriginRedirects(HTTPRedirectHandler):
+    def redirect_request(self, req, fp, code, msg, headers, newurl):
+        if origin(req.full_url) != origin(newurl):
+            raise ValueError('The host redirected to a different address. Enter the intended host address to join.')
+        return super().redirect_request(req, fp, code, msg, headers, newurl)
+
+
+def check_host(url):
+    opener = build_opener(SameOriginRedirects())
+    try:
+        with opener.open(url + '/healthz', timeout=3) as response:
+            body = response.read(4097)
+            account_host = body.strip() == b'ok' and bool(response.headers.get('X-Expanse-Server-Build'))
+            if not account_host and response.headers.get_content_type() == 'application/json' and len(body) <= 4096:
+                health = json.loads(body)
+                account_host = isinstance(health, dict) and health.get('status') == 'local-staging-only' and health.get('public_mmo') is False
+    except HTTPError as error:
+        error.close()
+        account_host = False
+    if account_host:
+        with opener.open(url + '/', timeout=3) as response:
+            page = response.read(256 * 1024).lower()
+            if response.headers.get_content_type() != 'text/html' or b'expanse' not in page or b'action="/login"' not in page:
+                raise ValueError('This host did not present an Expanse sign-in page.')
+        return
+
+    with opener.open(url + '/api/config', timeout=3) as response:
+        config = json.loads(response.read(1024 * 1024))
+    if config.get('mode') != 'host':
+        raise ValueError('That Expanse application is not hosting. Ask its owner to choose Host Network Game.')
+    with opener.open(url + '/index.html', timeout=3) as response:
+        markup = response.read(2 * 1024 * 1024)
+    if b'id="player-visual-map"' not in markup or b'/visual-map.js' not in markup:
+        raise ValueError('This host uses the retired ASCII map. Update the host to the tile-map release and rejoin.')
